# =============================================================================
# Rooster C2 — Validation Interview env vars
# Copy to .env.local for development. Set the same in Vercel for production.
# =============================================================================

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Admin (review + CSV/JSON export) ---
# Long random string. Used as Bearer token at /admin/validation and /api/validation/export.
VALIDATION_ADMIN_TOKEN=replace-with-long-random-string

# --- Storage: Vercel Postgres / Neon ---
# When you add the Vercel Postgres integration, these are populated automatically.
# For local dev, copy them from the Vercel project (Storage > .env.local snippet).
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Optional ---
# Comma-separated invite tokens auto-seeded on first DB init. Useful for dev/demo.
# Example: VALIDATION_SEED_INVITES=demo-2026,sme-alpha,pilot-bravo
VALIDATION_SEED_INVITES=
